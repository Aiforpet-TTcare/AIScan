    "pdf.comprehensive_cause": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are various possible causes that could lead to such abnormal signs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esistono varie possibili cause che potrebbero portare a tali segni anomali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このような異常の兆候を引き起こす原因はさまざまに考えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위와 같은 이상징후를 일으킬 수 있는 원인은 다양합니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finns flera möjliga orsaker som kan leda till sådana avvikande tecken."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีสาเหตุที่เป็นไปได้หลายอย่างที่อาจนำไปสู่สัญญาณผิดปกติเช่นนี้"
          }
        }
      }
    },
    "pdf.comprehensive_following": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At home, please keep the following in mind:"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A casa, tieni presente quanto segue:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ご家庭では、次の点に気をつけてください："
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "집에선 다음 사항을 주의해주세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tänk på följande hemma:"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ที่บ้าน โปรดคำนึงถึงสิ่งต่อไปนี้:"
          }
        }
      }
    },
    "pdf.comprehensive_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The observed abnormal signs may appear due to multiple underlying conditions. A more accurate and detailed diagnosis — and, if necessary, prompt treatment — may be required. For your pet's health, please consult your veterinarian."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I segni anomali osservati possono comparire a causa di molteplici condizioni sottostanti. Potrebbero essere necessari una diagnosi più accurata e dettagliata e, se necessario, un trattamento tempestivo. Per la salute del tuo animale, consulta il tuo veterinario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "観察された異常の兆候は、複数の基礎疾患によって現れている可能性があります。より正確で詳細な診断、そして必要に応じた迅速な治療が必要となることがあります。ペットの健康のため、かかりつけの獣医師にご相談ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관찰된 이상 징후는 여러 질환에 의해 나타날 수 있습니다. 보다 정확하고 세부적인 진단, 그리고 빠른 치료가 필요할 수 있습니다. 우리 아이의 건강을 위해 수의사 선생님과 꼭 상의해 주세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De observerade avvikande tecknen kan uppstå på grund av flera bakomliggande tillstånd. En mer noggrann och detaljerad diagnos – och vid behov snabb behandling – kan krävas. För ditt djurs hälsa, rådfråga din veterinär."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สัญญาณผิดปกติที่พบอาจเกิดจากภาวะแฝงหลายอย่าง อาจจำเป็นต้องได้รับการวินิจฉัยที่แม่นยำและละเอียดมากขึ้น และหากจำเป็น อาจต้องได้รับการรักษาโดยเร็ว เพื่อสุขภาพของสัตว์เลี้ยงของคุณ โปรดปรึกษาสัตวแพทย์"
          }
        }
      }
    },
    "pdf.comprehensive_recommendation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The following tests may be performed to determine the cause."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per determinare la causa potrebbero essere eseguiti i seguenti esami."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "原因を特定するために、次の検査が行われることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원인을 파악하기 위해 시행될 수 있는 검사의 종류는 다음과 같습니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Följande undersökningar kan utföras för att fastställa orsaken."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อาจมีการตรวจต่อไปนี้เพื่อหาสาเหตุ"
          }
        }
      }
    },
    "pdf.comprehensive_warning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please visit your veterinary clinic as soon as possible if you notice any of the following:"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rivolgiti alla tua clinica veterinaria il prima possibile se noti uno dei seguenti segni:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次のいずれかに気づいた場合は、できるだけ早く動物病院を受診してください："
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이럴 땐 가능한 빨리 병원에 내원해주시는 게 좋습니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Besök din veterinärklinik så snart som möjligt om du märker något av följande:"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรดพาไปพบคลินิกสัตวแพทย์โดยเร็วที่สุดหากคุณสังเกตเห็นสิ่งต่อไปนี้:"
          }
        }
      }
    },
    "pdf.cover_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health Screening\\nReport"
