    "pdf.detail_description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "However, these areas are examples and do not represent all possible regions where the symptom may appear."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuttavia, queste aree sono esempi e non rappresentano tutte le possibili regioni in cui il sintomo può comparire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ただし、これらの部位は一例であり、症状が現れうるすべての部位を表すものではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단, 이 영역은 예시이며 실제로 증상이 나타나는 모든 부위를 포함하는 것은 아닙니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessa områden är dock exempel och representerar inte alla möjliga regioner där symtomet kan uppträda."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อย่างไรก็ตาม บริเวณเหล่านี้เป็นเพียงตัวอย่างและไม่ได้แสดงถึงทุกบริเวณที่อาการอาจปรากฏ"
          }
        }
      }
    },
    "pdf.detail_not_detected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
