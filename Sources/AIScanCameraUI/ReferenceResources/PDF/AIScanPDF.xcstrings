    "pdf.detail_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The colored areas in the image indicate regions where the symptom is observed."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le aree colorate nell'immagine indicano le regioni in cui si osserva il sintomo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像内の色付きの部分は、症状が観察された領域を示しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지에 표시된 색상 영역은 해당 증상이 관찰되는 부위를 나타냅니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De färgade områdena i bilden visar regioner där symtomet observeras."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บริเวณที่มีสีในภาพแสดงถึงบริเวณที่พบอาการ"
          }
        }
      }
    },
